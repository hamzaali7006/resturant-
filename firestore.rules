rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    // Users can read and update only their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow create: if isAuthenticated() && (request.auth.uid == userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Profiles shouldn't be deleted directly
    }

    // Orders Collection
    // Only an authenticated customer can create and read their own orders.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          'id', 'userId', 'userEmail', 'userName', 'userPhone', 'items',
          'subtotal', 'tax', 'deliveryFee', 'tip', 'discount', 'total',
          'status', 'orderType', 'paymentMethod', 'paymentStatus',
          'estimatedMinutes', 'createdAt', 'syncedToFirebase', 'firestoreTimestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'userPhone', 'items',
          'subtotal', 'tax', 'deliveryFee', 'tip', 'discount', 'total',
          'status', 'orderType', 'deliveryAddress', 'tableNumber',
          'paymentMethod', 'paymentStatus', 'estimatedMinutes', 'createdAt',
          'syncedToFirebase', 'firestoreTimestamp'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.userName is string
        && request.resource.data.userPhone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.tax is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.tip is number
        && request.resource.data.discount is number
        && request.resource.data.total is number
        && request.resource.data.status == 'pending'
        && request.resource.data.orderType in ['delivery', 'pickup', 'dine_in']
        && request.resource.data.paymentMethod in ['gpay', 'card', 'cash']
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.estimatedMinutes is number
        && request.resource.data.createdAt is int
        && request.resource.data.syncedToFirebase == true
        && request.resource.data.firestoreTimestamp is timestamp;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';

      allow delete: if false;
    }

    // Table Bookings Collection
    // Patrons can create table reservations, view their reservations, and modify/cancel them
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      
      allow create: if (
        isAuthenticated() && request.resource.data.userId == request.auth.uid
      ) || (
        request.resource.data.guests is number &&
        request.resource.data.date is string &&
        request.resource.data.timeSlot is string
      );

      // Allow cancellation by patron
      allow update: if (
        isAuthenticated() && resource.data.userId == request.auth.uid
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      allow delete: if false;
    }

    // Menu Items Collection (Public read, admin write)
    match /menu/{menuId} {
      allow read: if true; // Any customer can browse the menu
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Tables Collection (Public read for availability)
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }
  }
}
